{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/AGENTS.md"
  ],
  "mcp": {
    "office-auto": {
      "type": "local",
      "command": [
        "node",
        "--import",
        "tsx",
        "mcp/office-auto-server.ts"
      ],
      "environment": {
        "OFFICE_AUTO_WORKSPACE": "${cwd}"
      },
      "enabled": true
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "doom_loop": "deny",
    "external_directory": "deny"
  }
}
