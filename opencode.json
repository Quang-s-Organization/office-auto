{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "officecli": {
      "type": "local",
      "command": ["officecli", "mcp"],
      "enabled": true,
      "environment": {
        "OFFICECLI_NO_AUTO_RESIDENT": "0"
      }
    },
    "office-auto": {
      "type": "local",
      "command": ["npx", "tsx", "src/mcp/office-auto-server.ts"],
      "enabled": true,
      "environment": {
        "LLAMA_BASE_URL": "https://appresearchpublic83.aiplatform.vcntt.tech",
        "LLAMA_USE_OPENAI": "1"
      }
    }
  },
  "default_agent": "docgen-orchestrator",
  "agent": {
    "docgen-orchestrator": {
      "mode": "primary",
      "model": "sglang/Qwen3.6-35B-A3B-GGUF",
      "description": "Orchestrates document generation pipeline.",
      "tools": {
        "office-auto*": true,
        "officecli*": true
      },
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    }
  }
}
