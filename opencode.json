{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "officecli": {
      "type": "local",
      "command": ["officecli", "mcp"],
      "enabled": true,
      "environment": {
        "OFFICECLI_NO_AUTO_RESIDENT": "0"
      }
    },
    "manifest-server": {
      "type": "local",
      "command": ["npx", "tsx", "src/mcp/manifest-server.ts"],
      "enabled": true
    }
  },
  "default_agent": "docgen-orchestrator",
  "agent": {
    "docgen-orchestrator": {
      "mode": "primary",
      "model": "sglang/Qwen3.6-35B-A3B-GGUF",
      "description": "Orchestrates document generation pipeline.",
      "tools": {
        "manifest-server*": true,
        "officecli*": true
      },
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    }
  }
}
