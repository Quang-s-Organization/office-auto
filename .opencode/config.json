{
  "provider": {
    "sglang": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "sglang",
      "options": {
        "baseURL": "https://appresearchpublic83.aiplatform.vcntt.tech/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-GGUF": {
          "name": "Qwen3.6-35B-A3B-GGUF"
        }
      }
    }
  },
  "model": "sglang/Qwen3.6-35B-A3B-GGUF",
  "models": {
    "sglang/Qwen3.6-35B-A3B-GGUF": {
      "temperature": 0.6,
      "top_p": 0.95,
      "top_k": 20
    }
  },
  "mcp": {
    "officecli": {
      "type": "local",
      "command": ["officecli", "mcp"],
      "enabled": true,
      "environment": {
        "OFFICECLI_NO_AUTO_RESIDENT": "0"
      }
    },
    "office-auto": {
      "type": "local",
      "command": ["npx", "tsx", "src/mcp/office-auto-server.ts"],
      "enabled": true,
      "environment": {
        "LLAMA_BASE_URL": "http://127.0.0.1:8080"
      }
    }
  },
  "agent": {
    "docgen-orchestrator": {
      "mode": "primary",
      "model": "sglang/Qwen3.6-35B-A3B-GGUF",
      "description": "Orchestrates document generation pipeline. Coordinates template audit, content normalization, docx rendering, and validation.",
      "tools": {
        "office-auto*": true,
        "officecli*": true
      },
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    }
  },
  "default_agent": "docgen-orchestrator"
}
