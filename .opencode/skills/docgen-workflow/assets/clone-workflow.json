[
  {
    "_comment": "Minimal v5 batch sample: remove a placeholder, then build one section.",
    "_run": "officecli batch <file> --input batch_program.json --json"
  },
  {"command": "remove", "path": "/body/p[@paraId=PLACEHOLDER_ID]"},

  {"command": "add", "parent": "/body", "type": "p",
   "props": {"style": "Heading1", "size": "14pt", "font.ea": "Times New Roman"}},
  {"command": "add", "parent": "/body/p[last()]", "type": "r",
   "props": {"text": "CHAPTER TITLE (verbatim from content.ir)"}},

  {"command": "add", "parent": "/body", "type": "p",
   "props": {"style": "Normalstyle", "size": "14pt", "font.ea": "Times New Roman"}},
  {"command": "add", "parent": "/body/p[last()]", "type": "r",
   "props": {"text": "Body paragraph text, verbatim from content.ir.json."}}
]
