{
  "id": "vn-thesis",
  "extends": "_base",
  "description": "Vietnamese research-proposal / thesis family. Overlay on _base: Vietnamese lexicon + proposal-specific roles where the document title is template front matter.",

  "//role_vocabulary": "Genre-specific roles ADDED to the base ontology (union).",
  "role_vocabulary": [
    "institution", "title_page", "list_of", "rationale",
    "objective", "research_question", "scope", "timeline", "outline"
  ],

  "role_descriptions": {
    "institution":       "Cơ quan chủ quản / trường / học viện (trang bìa).",
    "title_page":        "Tên đề tài, loại hình (đề cương/luận văn/luận án/khóa luận).",
    "list_of":           "Mục lục / danh mục bảng, hình, từ viết tắt.",
    "rationale":         "Lý do, tính cấp thiết, đặt vấn đề (mở đầu).",
    "objective":         "Mục tiêu, nhiệm vụ nghiên cứu.",
    "research_question": "Câu hỏi / giả thuyết nghiên cứu.",
    "scope":             "Đối tượng và phạm vi nghiên cứu.",
    "timeline":          "Tiến độ, kế hoạch thực hiện.",
    "outline":           "Bố cục / cấu trúc của báo cáo."
  },

  "//keyword_rules": "Vietnamese surface forms (uppercased, accent-kept). Replaces the (empty) base list. Order = priority.",
  "keyword_rules": [
    {"role": "institution",       "any": ["BỘ GIÁO DỤC", "TRƯỜNG ĐẠI HỌC", "ĐẠI HỌC QUỐC GIA", "HỌC VIỆN"]},
    {"role": "title_page",        "any": ["ĐỀ CƯƠNG", "LUẬN VĂN", "LUẬN ÁN", "KHÓA LUẬN", "ĐỒ ÁN"]},
    {"role": "list_of",          "any": ["DANH MỤC", "MỤC LỤC"]},
    {"role": "rationale",         "any": ["LÝ DO", "TÍNH CẤP THIẾT", "ĐẶT VẤN ĐỀ"]},
    {"role": "research_question", "any": ["CÂU HỎI NGHIÊN CỨU"]},
    {"role": "objective",         "any": ["MỤC TIÊU", "NHIỆM VỤ NGHIÊN CỨU"]},
    {"role": "scope",             "any": ["ĐỐI TƯỢNG", "PHẠM VI"]},
    {"role": "methodology",       "any": ["PHƯƠNG PHÁP"]},
    {"role": "literature_review", "any": ["TỔNG QUAN", "CƠ SỞ LÝ", "NGHIÊN CỨU TRƯỚC", "TÌNH HÌNH NGHIÊN CỨU"]},
    {"role": "timeline",          "any": ["TIẾN ĐỘ", "KẾ HOẠCH THỰC HIỆN"]},
    {"role": "outline",           "any": ["BỐ CỤC", "CẤU TRÚC"]},
    {"role": "conclusion",        "any": ["KẾT LUẬN", "KIẾN NGHỊ"]},
    {"role": "references",        "any": ["TÀI LIỆU THAM KHẢO", "DANH MỤC TÀI LIỆU"]},
    {"role": "appendix",          "any": ["PHỤ LỤC"]}
  ],

  "//front_matter_roles": "Roles the template already provides → intent=preserve (NOT re-emitted). Keeps the cover page from duplicating.",
  "front_matter_roles": ["institution", "title_page"],

  "//role_to_logical": "Proposal-specific placement, MERGED onto the base 9 shared entries.",
  "role_to_logical": {
    "institution":       {"section": "FrontMatter",   "intent": "preserve", "toc": false, "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "title_page":        {"section": "TitlePage",      "intent": "preserve", "toc": false, "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "list_of":           {"section": "Lists",          "intent": "insert",  "toc": false, "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "rationale":         {"section": "Introduction",   "intent": "replace", "toc": true,  "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "objective":         {"section": "Objectives",     "intent": "replace", "toc": true,  "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "research_question": {"section": "Objectives",     "intent": "replace", "toc": true,  "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "scope":             {"section": "Scope",          "intent": "replace", "toc": true,  "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "timeline":          {"section": "Timeline",       "intent": "replace", "toc": true,  "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"},
    "outline":           {"section": "Outline",        "intent": "replace", "toc": true,  "presentation": "FROM_LEVEL", "outline_level": "FROM_LEVEL"}
  }
}
