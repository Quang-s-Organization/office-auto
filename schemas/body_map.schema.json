{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["template_path", "inspected_at", "headings", "body_styles_seen", "toc_present", "total_paragraphs"],
  "properties": {
    "template_path": { "type": "string" },
    "inspected_at": { "type": "string", "format": "date-time" },
    "headings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["style", "text", "path", "paraId", "index_in_body"],
        "properties": {
          "style": { "type": "string" },
          "text": { "type": "string" },
          "path": { "type": "string" },
          "paraId": { "type": "string" },
          "index_in_body": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "body_styles_seen": {
      "type": "array",
      "items": { "type": "string" }
    },
    "toc_present": { "type": "boolean" },
    "total_paragraphs": { "type": "integer", "minimum": 0 }
  }
}
